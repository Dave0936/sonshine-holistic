{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "brand-guidelines/**",
              "components/buttons/**",
              "components/classes/**",
              "components/footer/**",
              "components/icons/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Playfair Display|Poppins|Inter))/i]",
        "message": "Font not provided by the design system. Available: Playfair Display, Poppins, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|size|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: initials, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackToTop'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|hover|onClick|style|key|ref|className|style|children)$/]",
        "message": "<BackToTop> doesn't accept that prop. Declared props: children, hover, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|hover|fullWidth|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, hover, fullWidth, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:hero|block|outline)$/]",
        "message": "<Button> variant must be one of 'hero' | 'block' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClassCardText'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|hover|style|key|ref|className|style|children)$/]",
        "message": "<ClassCardText> doesn't accept that prop. Declared props: title, description, hover, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClassRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:cells|columns|hover|bookLabel|onBook|style|key|ref|className|style|children)$/]",
        "message": "<ClassRow> doesn't accept that prop. Declared props: cells, columns, hover, bookLabel, onBook, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:email|hover|style|key|ref|className|style|children)$/]",
        "message": "<EmailLink> doesn't accept that prop. Declared props: email, hover, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|align|hover|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FooterLink> doesn't accept that prop. Declared props: children, align, hover, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterLink'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<FooterLink> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|hover|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<GlassButton> doesn't accept that prop. Declared props: children, hover, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|variant|color|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, variant, color, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavDropdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|hover|open|items|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<NavDropdown> doesn't accept that prop. Declared props: children, hover, open, items, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|hover|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: children, active, hover, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SmallButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|hover|width|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SmallButton> doesn't accept that prop. Declared props: children, tone, icon, hover, width, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SmallButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:rose|soft|whatsapp|outline)$/]",
        "message": "<SmallButton> tone must be one of 'rose' | 'soft' | 'whatsapp' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:network|hover|href|style|key|ref|className|style|children)$/]",
        "message": "<SocialLink> doesn't accept that prop. Declared props: network, hover, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialLink'] > JSXAttribute[name.name='network'] > Literal[value!=/^(?:instagram|facebook)$/]",
        "message": "<SocialLink> network must be one of 'instagram' | 'facebook'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
